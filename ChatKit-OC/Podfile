target 'ChatKit-OC' do
  project 'ChatKit-OC.xcodeproj'
  platform :ios, '15.0'
  inhibit_all_warnings!

  #=========================================================
  #======================== Lib Dependency =================
  #=========================================================
  pod 'CYLChatKit', :path => '../'

  #=========================================================
  #======================== Demo Dependency ================
  #=========================================================

  # The LeanCloud IM backend (LCCKLeanCloudIMProvider) lives in the demo, not in ChatKit.
  pod 'AVOSCloud', '11.5.2'
  pod 'AVOSCloudIM', '11.5.2'

  pod 'CYLTabBarController', '1.99.72'
  pod 'TWMessageBarManager', '1.8.1'
  pod 'MLPAutoCompleteTextField', '1.5'
  pod 'FTPopOverMenu', '2.1.4'
  pod 'FXForms', '1.2.14'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
